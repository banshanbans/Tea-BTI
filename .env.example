DATABASE_URL=sqlite:////data/tea-bti.db
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# auto uses Volcengine only when every required credential is present.
AI_MODE=auto
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
ARK_TEXT_MODEL=doubao-seed-2-0-lite-260215
ARK_VISION_MODEL=doubao-seed-2-0-lite-260215
ARK_VOICE_ENDPOINT_ID=
BREW_COMPANION_V2=true
BREW_VOICE_SESSION_TTL_SECONDS=1800

VOLC_ACCESS_KEY_ID=
VOLC_SECRET_ACCESS_KEY=
RTC_APP_ID=
RTC_APP_KEY=
RTC_API_VERSION=2025-06-01
RTC_VOICE_MODEL_ID=
# Full StartVoiceChat 2025-06-01 console Config template. Server-side only.
RTC_VOICE_CONFIG_JSON=

# Deprecated direct Speech fields. Kept only for old local env compatibility;
# the 2025-06-01 voice path uses RTC_VOICE_CONFIG_JSON above.
DOUBAO_SPEECH_APP_ID=
DOUBAO_SPEECH_ACCESS_TOKEN=
DOUBAO_ASR_RESOURCE_ID=
DOUBAO_ASR_CLUSTER=
DOUBAO_TTS_RESOURCE_ID=
DOUBAO_TTS_VOICE_TYPE=BV001_streaming
