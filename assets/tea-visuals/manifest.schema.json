{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tea-bti.local/schemas/tea-visual-manifest.schema.json",
  "title": "Tea-BTI Tea Visual Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "visual_grammar_version", "generated_at", "review_viewport", "teas", "review_exports"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 3},
    "visual_grammar_version": {"const": "0.2"},
    "generated_at": {"type": "string", "format": "date-time"},
    "review_viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {"width": {"const": 390}, "height": {"const": 844}}
    },
    "teas": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/tea"}},
    "review_exports": {"type": "array"}
  },
  "$defs": {
    "dimensions": {
      "type": "object",
      "required": ["master_width", "master_height", "media_width", "media_height"],
      "properties": {
        "master_width": {"type": "integer", "minimum": 1}, "master_height": {"type": "integer", "minimum": 1},
        "media_width": {"type": "integer", "minimum": 1}, "media_height": {"type": "integer", "minimum": 1}
      }
    },
    "presentation_asset": {
      "allOf": [{"$ref": "#/$defs/dimensions"}],
      "type": "object",
      "required": ["id", "role", "active", "source_kind", "authenticity_state", "rights_state", "rights_note", "source_url", "master_path", "media_path", "crop_strategy", "master_sha256", "sha256", "card_copy"],
      "properties": {
        "id": {"type": "string"}, "role": {"const": "presentation"}, "active": {"const": true},
        "source_kind": {"const": "user_provided"}, "authenticity_state": {"const": "stylized_demo"},
        "rights_state": {"const": "demo_only"}, "rights_note": {"type": "string"}, "source_url": {"type": "string", "format": "uri"},
        "master_path": {"type": "string"}, "media_path": {"type": "string"},
        "crop_strategy": {"type": "object", "required": ["aspect_ratio", "object_position"]},
        "master_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "card_copy": {"type": "object", "required": ["headline", "body", "tags", "scene"]}
      }
    },
    "detail_asset": {
      "allOf": [{"$ref": "#/$defs/dimensions"}],
      "type": "object",
      "required": ["id", "role", "source_kind", "authenticity_state", "rights_state", "rights_note", "source_url", "credit", "original_path", "master_path", "media_path", "object_position", "original_sha256", "master_sha256", "sha256", "edit_chain"],
      "properties": {
        "id": {"type": "string"}, "role": {"const": "detail"}, "source_kind": {"const": "third_party_photo"},
        "authenticity_state": {"const": "reference"}, "rights_state": {"const": "unknown"},
        "rights_note": {"type": "string"}, "source_url": {"type": "string", "format": "uri"}, "credit": {"type": "string"},
        "original_path": {"type": "string"}, "master_path": {"type": "string"}, "media_path": {"type": "string"}, "object_position": {"type": "string"},
        "original_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "master_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "edit_note": {"type": ["string", "null"]}, "edit_chain": {"type": "array"}
      }
    },
    "tea": {
      "type": "object",
      "required": ["tea_id", "name", "region", "visual_profile", "assets", "legacy_assets", "detail_asset", "realm_assets"],
      "properties": {
        "tea_id": {"type": "string"}, "name": {"type": "string"}, "region": {"type": "string"},
        "visual_profile": {"type": "object"},
        "assets": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/presentation_asset"}},
        "legacy_assets": {"type": "array"}, "detail_asset": {"$ref": "#/$defs/detail_asset"}, "realm_assets": {"type": "array"}
      }
    }
  }
}
